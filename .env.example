# Jupiter credentials (required by JupiterClient)
JUPITER_API_KEY=
PAPER_WALLET_ADDRESS=

# Jupiter paper scanner
JUPITER_BASE_URL=https://api.jup.ag
TRADE_SIZE_SOL=0.1
SLIPPAGE_BPS=30
EXECUTION_BUFFER_BPS=10
MIN_NET_PROFIT_BPS=5
TRANSACTION_FEE_LAMPORTS=5000
MAX_QUOTE_WINDOW_MS=2000
REQUEST_TIMEOUT_MS=10000
ORCA_DEXES=Orca V2,Whirlpool
RAYDIUM_DEXES=Raydium,Raydium CLMM,Raydium CP

# Existing DexScreener logger
POLL_INTERVAL_MS=3000
CSV_PATH=./data/sol_usdc_spreads.csv
SEARCH_QUERY=SOL/USDC
MIN_LIQUIDITY_USD=100000
